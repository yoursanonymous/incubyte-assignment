# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://dealership:dealership_dev_pw@localhost:5432/dealership_dev
DB_POOL_MAX=10
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ISSUER=dealership-api
JWT_AUDIENCE=dealership-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of browser origins allowed for CORS and cookie-authenticated POSTs.
CORS_ORIGINS=http://localhost:5173
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Used only by `npm run admin:create` and the dev seed.
ADMIN_EMAIL=admin@dealership.test
ADMIN_PASSWORD=ChangeMe-Admin-123!
